script/source = "extends PDJE_Judge_Module


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass


func _on_pdje_judge_custom_mouse_parse_signal(microsecond: String, found_events: Array, rail_id: String, X: int, Y: int, AXIS_ENUM: int) -> void:
	pass # Replace with function body.


func _on_pdje_judge_miss_signal(missed_list: Dictionary) -> void:
	print(\"MISSED\", missed_list)
	


func _on_pdje_judge_use_signal(rail_id: String, is_pressed: bool, is_late: bool, time_diff: String) -> void:
	print(\"note used!!!\")
	var microSecond = int(time_diff)
	var diffmsg:String
	if is_late:
		diffmsg = \"LATE-\"+str(microSecond/1000.0) + \"ms\"
	else:
		diffmsg = \"EARLY-\"+str(microSecond/1000.0) + \"ms\"
	if microSecond < 20000:
		print(\"GREAT! \", diffmsg)
	else:
		print(\"GOOD \", diffmsg)
	
"

